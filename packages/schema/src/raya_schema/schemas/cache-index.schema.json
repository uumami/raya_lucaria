{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/cache-index.schema.json",
  "title": "Raya Cache Metadata Index",
  "type": "object",
  "required": [
    "course_id",
    "entries"
  ],
  "properties": {
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "source_path",
          "policy",
          "source_sha256",
          "schema_version",
          "cache_key"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "enum": [
              "cache",
              "always",
              "frozen"
            ]
          },
          "runtime_profile": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "input_hashes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "runtime_profile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lockfile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "cache_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
