{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/reviewed-output-source.schema.json",
  "title": "Raya Reviewed Output Source Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "target_id",
    "source_path",
    "kind",
    "source_sha256",
    "input_hashes",
    "review_key",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_target_id": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "code",
        "notebook"
      ]
    },
    "policy": {
      "enum": [
        "manual",
        "cache",
        "always",
        "frozen"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "runtime_profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lockfile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
