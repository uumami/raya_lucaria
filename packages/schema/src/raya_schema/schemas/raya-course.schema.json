{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/raya-course.schema.json",
  "title": "Raya Course Configuration",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "course_id",
    "title",
    "description",
    "language",
    "source",
    "artifact",
    "calendar"
  ],
  "properties": {
    "course_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "calendar": {
      "type": "object",
      "required": ["timezone"],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "institution": {
      "type": "string"
    },
    "course_team": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
