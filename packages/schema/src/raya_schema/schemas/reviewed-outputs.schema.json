{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/reviewed-outputs.schema.json",
  "title": "Raya Reviewed Execution Outputs",
  "type": "object",
  "required": [
    "course_id",
    "authority",
    "outputs"
  ],
  "properties": {
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "reviewed-course-support"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target_id",
          "reference_id",
          "source_path",
          "source_support_path",
          "kind",
          "policy",
          "status",
          "authority",
          "source_sha256",
          "input_hashes",
          "review_key",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "runtime_target_id": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_support_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "notebook"
            ]
          },
          "policy": {
            "enum": [
              "manual",
              "cache",
              "always",
              "frozen"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "current"
          },
          "authority": {
            "const": "reviewed-course-support"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "input_hashes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "runtime_profile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lockfile_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "cache_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "review_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "kind",
                "sha256",
                "source_path",
                "artifact_path",
                "browser_path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_path": {
                  "type": "string",
                  "minLength": 1
                },
                "browser_path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
