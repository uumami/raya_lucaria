{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/execution-index.schema.json",
  "title": "Raya Execution Plan Index",
  "type": "object",
  "required": [
    "course_id",
    "targets"
  ],
  "properties": {
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_path",
          "kind",
          "policy",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "notebook"
            ]
          },
          "policy": {
            "enum": [
              "never",
              "manual",
              "cache",
              "always",
              "frozen"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "not-executed"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
