{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/navigation-index.schema.json",
  "title": "Raya Navigation Index",
  "type": "object",
  "required": [
    "course_id",
    "root",
    "items"
  ],
  "properties": {
    "course_id": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "url",
          "title",
          "label",
          "children"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "nav_title": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "hierarchy_key": {
            "type": "string"
          },
          "hierarchy_label": {
            "type": "string"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "breadcrumbs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "previous": {
            "type": [
              "string",
              "null"
            ]
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
