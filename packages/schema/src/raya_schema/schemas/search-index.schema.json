{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raya-lucaria.local/schemas/search-index.schema.json",
  "title": "Raya Search Index",
  "type": "object",
  "required": [
    "version",
    "pages"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "search_text",
          "search_snippet",
          "sections"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "search_text": {
            "type": "string"
          },
          "search_snippet": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "anchor",
                "id",
                "search_snippet",
                "search_text",
                "title"
              ],
              "properties": {
                "anchor": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "search_snippet": {
                  "type": "string",
                  "minLength": 1
                },
                "search_text": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
